class Solution {
public:
    int maxNumberOfFamilies(int n, vector<vector<int>>& reservedSeats) {
        unordered_map<int, int> rows;

        // Mark reserved seats for each row
        for (auto &seat : reservedSeats) {
            int row = seat[0];
            int col = seat[1];

            rows[row] |= (1 << (col - 1));
        }

        int ans = (n - rows.size()) * 2;

        // Masks for the possible blocks:
        // 2,3,4,5 -> 0111100000
        // 4,5,6,7 -> 0011110000
        // 6,7,8,9 -> 0000111100

        int left  = (1 << 1) | (1 << 2) | (1 << 3) | (1 << 4);
        int mid   = (1 << 3) | (1 << 4) | (1 << 5) | (1 << 6);
        int right = (1 << 5) | (1 << 6) | (1 << 7) | (1 << 8);

        for (auto &[row, mask] : rows) {
            bool canLeft = (mask & left) == 0;
            bool canMid = (mask & mid) == 0;
            bool canRight = (mask & right) == 0;

            if (canLeft && canRight) {
                // Two non-overlapping groups
                ans += 2;
            } 
            else if (canLeft || canMid || canRight) {
                // At least one group can fit
                ans += 1;
            }
        }

        return ans;
    }
};
