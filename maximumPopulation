class Solution {
public:
    int maximumPopulation(vector<vector<int>>& logs) {
        vector<int> diff(101, 0);

        for (auto &log : logs) {
            diff[log[0] - 1950]++;
            diff[log[1] - 1950]--;
        }

        int ans = 1950;
        int cur = 0, mx = 0;

        for (int i = 0; i < 101; i++) {
            cur += diff[i];
            if (cur > mx) {
                mx = cur;
                ans = 1950 + i;
            }
        }

        return ans;
    }
};
