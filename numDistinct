class Solution {
public:
    int numDistinct(string s, string t) {
        int n = s.size();
        int m = t.size();

        vector<long long> dp(m + 1, 0);

        // Empty t can always be formed in exactly one way.
        dp[0] = 1;

        for (int i = 0; i < n; i++) {

            // Go backwards so dp[j - 1] still represents
            // the previous row.
            for (int j = m; j >= 1; j--) {

                if (s[i] == t[j - 1]) {
                    dp[j] += dp[j - 1];
                }
            }
        }

        return dp[m];
    }
};
