class Solution {
public:
    int largestPathValue(string colors, vector<vector<int>>& edges) {
        int n = colors.size();

        vector<vector<int>> graph(n);
        vector<int> indegree(n, 0);

        for (auto &e : edges) {
            graph[e[0]].push_back(e[1]);
            indegree[e[1]]++;
        }

        vector<vector<int>> dp(n, vector<int>(26, 0));
        queue<int> q;

        for (int i = 0; i < n; i++) {
            if (indegree[i] == 0)
                q.push(i);
            dp[i][colors[i] - 'a'] = 1;
        }

        int visited = 0;
        int ans = 0;

        while (!q.empty()) {
            int u = q.front();
            q.pop();
            visited++;

            for (int c = 0; c < 26; c++)
                ans = max(ans, dp[u][c]);

            for (int v : graph[u]) {
                for (int c = 0; c < 26; c++) {
                    dp[v][c] = max(dp[v][c],
                                   dp[u][c] + (c == colors[v] - 'a' ? 1 : 0));
                }

                if (--indegree[v] == 0)
                    q.push(v);
            }
        }

        return visited == n ? ans : -1;
    }
};
