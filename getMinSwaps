class Solution {
public:
    int getMinSwaps(string num, int k) {
        string target = num;

        // Find the k-th next permutation
        while (k--) {
            next_permutation(target.begin(), target.end());
        }

        int ans = 0;
        string cur = num;

        for (int i = 0; i < cur.size(); i++) {
            if (cur[i] == target[i]) continue;

            int j = i + 1;
            while (cur[j] != target[i]) j++;

            while (j > i) {
                swap(cur[j], cur[j - 1]);
                ans++;
                j--;
            }
        }

        return ans;
    }
};
