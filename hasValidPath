class Solution {
public:
    bool hasValidPath(vector<vector<int>>& grid) {

        int m = grid.size(), n = grid[0].size();

        vector<vector<int>> dirs = {
            {},
            {1,3},
            {0,2},
            {2,3},
            {1,2},
            {0,3},
            {0,1}
        };

        int dr[4] = {-1,0,1,0};
        int dc[4] = {0,1,0,-1};
        int opp[4] = {2,3,0,1};

        queue<pair<int,int>> q;
        vector<vector<bool>> vis(m, vector<bool>(n,false));

        q.push({0,0});
        vis[0][0] = true;

        while(!q.empty()) {
            auto [r,c] = q.front();
            q.pop();

            if(r==m-1 && c==n-1)
                return true;

            int type = grid[r][c];

            for(int d : dirs[type]) {

                int nr = r + dr[d];
                int nc = c + dc[d];

                if(nr<0 || nr>=m || nc<0 || nc>=n)
                    continue;

                if(vis[nr][nc])
                    continue;

                bool connect = false;

                for(int nd : dirs[grid[nr][nc]]) {
                    if(nd == opp[d]) {
                        connect = true;
                        break;
                    }
                }

                if(connect) {
                    vis[nr][nc] = true;
                    q.push({nr,nc});
                }
            }
        }

        return false;
    }
};
