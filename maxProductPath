class Solution {
public:
    int maxProductPath(vector<vector<int>>& grid) {
        int m = grid.size(), n = grid[0].size();
        const long long MOD = 1e9 + 7;

        vector<vector<long long>> mx(m, vector<long long>(n));
        vector<vector<long long>> mn(m, vector<long long>(n));

        mx[0][0] = mn[0][0] = grid[0][0];

        // First row
        for (int j = 1; j < n; j++) {
            mx[0][j] = mn[0][j] = mx[0][j - 1] * grid[0][j];
        }

        // First column
        for (int i = 1; i < m; i++) {
            mx[i][0] = mn[i][0] = mx[i - 1][0] * grid[i][0];
        }

        for (int i = 1; i < m; i++) {
            for (int j = 1; j < n; j++) {
                long long x = grid[i][j];

                vector<long long> cand = {
                    mx[i - 1][j] * x,
                    mn[i - 1][j] * x,
                    mx[i][j - 1] * x,
                    mn[i][j - 1] * x
                };

                mx[i][j] = *max_element(cand.begin(), cand.end());
                mn[i][j] = *min_element(cand.begin(), cand.end());
            }
        }

        long long ans = mx[m - 1][n - 1];

        if (ans < 0)
            return -1;

        return ans % MOD;
    }
};
