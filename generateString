class Solution {
public:
    string generateString(string str1, string str2) {
        int n = str1.size(), m = str2.size();
        int L = n + m - 1;

        string ans(L, '?');
        vector<bool> freePos(L, true);

        // Apply T constraints
        for (int i = 0; i < n; i++) {
            if (str1[i] == 'T') {
                for (int j = 0; j < m; j++) {
                    if (ans[i + j] != '?' && ans[i + j] != str2[j])
                        return "";

                    ans[i + j] = str2[j];
                    freePos[i + j] = false;
                }
            }
        }

        // Fill remaining with 'a'
        for (int i = 0; i < L; i++)
            if (ans[i] == '?')
                ans[i] = 'a';

        // Process F constraints
        for (int i = 0; i < n; i++) {
            if (str1[i] == 'F') {

                bool same = true;
                for (int j = 0; j < m; j++) {
                    if (ans[i + j] != str2[j]) {
                        same = false;
                        break;
                    }
                }

                if (!same) continue;

                bool changed = false;

                for (int j = m - 1; j >= 0 && !changed; j--) {
                    int pos = i + j;

                    if (!freePos[pos]) continue;

                    for (char c = 'a'; c <= 'z'; c++) {
                        if (c != str2[j]) {
                            ans[pos] = c;
                            changed = true;
                            break;
                        }
                    }
                }

                if (!changed)
                    return "";
            }
        }

        return ans;
    }
};
