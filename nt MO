class Solution {
public:
    const int MOD = 1e9 + 7;
    int LOG;
    vector<vector<int>> up, adj;
    vector<int> depth;

    long long modPow(long long a, long long b) {
        long long res = 1;
        while (b) {
            if (b & 1) res = res * a % MOD;
            a = a * a % MOD;
            b >>= 1;
        }
        return res;
    }

    void dfs(int u, int p) {
        up[0][u] = p;
        for (int i = 1; i < LOG; i++)
            up[i][u] = up[i - 1][up[i - 1][u]];

        for (int v : adj[u]) {
            if (v == p) continue;
            depth[v] = depth[u] + 1;
            dfs(v, u);
        }
    }

    int lca(int u, int v) {
        if (depth[u] < depth[v]) swap(u, v);

        int diff = depth[u] - depth[v];
        for (int i = LOG - 1; i >= 0; i--)
            if (diff & (1 << i))
                u = up[i][u];

        if (u == v) return u;

        for (int i = LOG - 1; i >= 0; i--) {
            if (up[i][u] != up[i][v]) {
                u = up[i][u];
                v = up[i][v];
            }
        }

        return up[0][u];
    }

    vector<int> assignEdgeWeights(vector<vector<int>>& edges,
                                  vector<vector<int>>& queries) {
        int n = edges.size() + 1;

        LOG = 1;
        while ((1 << LOG) <= n) LOG++;

        adj.assign(n + 1, {});
        for (auto &e : edges) {
            adj[e[0]].push_back(e[1]);
            adj[e[1]].push_back(e[0]);
        }

        up.assign(LOG, vector<int>(n + 1));
        depth.assign(n + 1, 0);

        dfs(1, 1);

        vector<int> ans;

        for (auto &q : queries) {
            int u = q[0], v = q[1];
            int w = lca(u, v);

            int dist = depth[u] + depth[v] - 2 * depth[w];

            if (dist == 0)
                ans.push_back(0);
            else
                ans.push_back(modPow(2, dist - 1));
        }

        return ans;
    }
};
