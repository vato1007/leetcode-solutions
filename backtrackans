class Solution {
public:
    vector<string> ans;

    void backtrack(string& s, int index, int parts, string current) {
        // 4 parts created
        if (parts == 4) {
            if (index == s.size()) {
                current.pop_back(); // remove final '.'
                ans.push_back(current);
            }
            return;
        }

        // Try taking 1, 2, or 3 digits
        for (int len = 1; len <= 3; len++) {
            if (index + len > s.size())
                break;

            string part = s.substr(index, len);

            // Leading zero is invalid
            if (part.size() > 1 && part[0] == '0')
                break;

            // Value must be <= 255
            if (stoi(part) > 255)
                break;

            backtrack(
                s,
                index + len,
                parts + 1,
                current + part + "."
            );
        }
    }

    vector<string> restoreIpAddresses(string s) {
        // An IP has exactly 4 parts, each 1-3 digits
        if (s.size() < 4 || s.size() > 12)
            return {};

        backtrack(s, 0, 0, "");

        return ans;
    }
};
