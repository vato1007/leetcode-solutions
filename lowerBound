class Solution {
public:
    vector<vector<int>> rob;
    vector<int> w;
    vector<vector<int>> dp;
    int n;

    int lowerBound(int x) {
        return lower_bound(w.begin(), w.end(), x) - w.begin();
    }

    int dfs(int i, int state) {
        if (i < 0) return 0;
        if (dp[i][state] != -1) return dp[i][state];

        // Shoot left
        int left = rob[i][0] - rob[i][1];
        if (i > 0)
            left = max(left, rob[i - 1][0] + 1);

        int l = lowerBound(left);
        int r = lowerBound(rob[i][0] + 1);

        int ans = dfs(i - 1, 0) + (r - l);

        // Shoot right
        int right = rob[i][0] + rob[i][1];

        if (i + 1 < n) {
            if (state == 0)
                right = min(right, rob[i + 1][0] - rob[i + 1][1] - 1);
            else
                right = min(right, rob[i + 1][0] - 1);
        }

        l = lowerBound(rob[i][0]);
        r = lowerBound(right + 1);

        ans = max(ans, dfs(i - 1, 1) + (r - l));

        return dp[i][state] = ans;
    }

    int maxWalls(vector<int>& robots, vector<int>& distance, vector<int>& walls) {
        n = robots.size();

        rob.resize(n);
        for (int i = 0; i < n; i++)
            rob.push_back({robots[i], distance[i]});

        rob.clear();
        for (int i = 0; i < n; i++)
            rob.push_back({robots[i], distance[i]});

        sort(rob.begin(), rob.end());
        sort(walls.begin(), walls.end());

        w = walls;
        dp.assign(n, vector<int>(2, -1));

        return dfs(n - 1, 1);
    }
};
