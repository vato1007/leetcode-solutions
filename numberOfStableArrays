class Solution {
public:
    static const int MOD = 1e9 + 7;

    int numberOfStableArrays(int zero, int one, int limit) {
        vector<vector<int>> dp0(zero + 1, vector<int>(one + 1));
        vector<vector<int>> dp1(zero + 1, vector<int>(one + 1));

        dp0[1][0] = 1;
        dp1[0][1] = 1;

        for (int i = 0; i <= zero; i++) {
            for (int j = 0; j <= one; j++) {

                if (i > 0) {
                    long long sum = 0;
                    for (int k = 1; k <= limit && i - k >= 0; k++)
                        sum = (sum + dp1[i - k][j]) % MOD;

                    if (j == 0 && i <= limit)
                        sum = 1;

                    dp0[i][j] = sum;
                }

                if (j > 0) {
                    long long sum = 0;
                    for (int k = 1; k <= limit && j - k >= 0; k++)
                        sum = (sum + dp0[i][j - k]) % MOD;

                    if (i == 0 && j <= limit)
                        sum = 1;

                    dp1[i][j] = sum;
                }
            }
        }

        return (dp0[zero][one] + dp1[zero][one]) % MOD;
    }
};
