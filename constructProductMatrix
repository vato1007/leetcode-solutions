class Solution {
public:
    vector<vector<int>> constructProductMatrix(vector<vector<int>>& grid) {
        const int MOD = 12345;

        int n = grid.size();
        int m = grid[0].size();
        int N = n * m;

        vector<int> arr;
        arr.reserve(N);

        for (auto &row : grid)
            for (int x : row)
                arr.push_back(x % MOD);

        vector<int> pref(N), suff(N);

        pref[0] = 1;
        for (int i = 1; i < N; i++) {
            pref[i] = (1LL * pref[i - 1] * arr[i - 1]) % MOD;
        }

        suff[N - 1] = 1;
        for (int i = N - 2; i >= 0; i--) {
            suff[i] = (1LL * suff[i + 1] * arr[i + 1]) % MOD;
        }

        vector<vector<int>> ans(n, vector<int>(m));

        for (int i = 0; i < N; i++) {
            ans[i / m][i % m] = (1LL * pref[i] * suff[i]) % MOD;
        }

        return ans;
    }
};
